{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/skd-car-kits.html",
      "destination": "/electric-trucks.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
